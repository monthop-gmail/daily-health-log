{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daily-health-log",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",

  // หน้าเว็บ (ไฟล์ใน public/) เสิร์ฟตรงจาก Workers Static Assets
  // ส่วน /api/* ให้ Worker จัดการก่อนเสมอ
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // database_id ด้านล่างเป็นของ deployment ต้นฉบับ (monthop-gmail)
  // - ถ้า deploy ด้วยปุ่ม "Deploy to Cloudflare" ระบบจะสร้างฐานข้อมูลใหม่และแก้ค่านี้ให้เอง
  // - ถ้า fork ไป deploy เองด้วย wrangler: รัน `npx wrangler d1 create daily-health-log`
  //   แล้วเอา database_id ที่ได้มาใส่แทนค่าด้านล่าง
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "daily-health-log",
      "database_id": "acd38325-54cf-4586-9e9c-7eff2e6ccbb0",
      "migrations_dir": "migrations"
    }
  ],

  // ทุกนาที: ตรวจว่าถึงเวลาเตือนยา/นัดหมอหรือยัง (ทำงานเฉพาะเมื่อมีเครื่องเปิดรับการแจ้งเตือน)
  "triggers": { "crons": ["* * * * *"] },

  "observability": { "enabled": true }

  // Secrets (ตั้งด้วย npx wrangler secret put <NAME>):
  //   APP_PASSWORD  — รหัสผ่านเข้าแอป อย่างน้อย 8 ตัว (จำเป็น)
  //   API_TOKEN     — token สำหรับบันทึกผ่าน API/Shortcuts (ไม่บังคับ)
}
